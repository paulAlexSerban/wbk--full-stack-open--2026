@BASE_URL=http://localhost:3001

### Get all persons
GET {{BASE_URL}}/api/persons

### Get single person (existing)
GET {{BASE_URL}}/api/persons/1

### Get single person (non-existent)
GET {{BASE_URL}}/api/persons/99

### Get info page
GET {{BASE_URL}}/info

### Create new person - SUCCESS
POST {{BASE_URL}}/api/persons
Content-Type: application/json

{
  "name": "John Doe",
  "number": "040-123456"
}

### Create new person - MISSING FIELD
POST {{BASE_URL}}/api/persons
Content-Type: application/json

{
  "name": "Jane Smith"
}

### Create new person - DUPLICATE NAME
POST {{BASE_URL}}/api/persons
Content-Type: application/json

{
  "name": "Arto Hellas",
  "number": "999-999-9999"
}

### Delete existing person
DELETE {{BASE_URL}}/api/persons/2

### Delete non-existent person
DELETE {{BASE_URL}}/api/persons/99

### DEBUG
GET {{BASE_URL}}/api/debug